{
  "name": "recaps-pro-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Workers backend for Recap Studio AI (R2 storage + Gemini Files API + recap job engine)",
  "scripts": {
    "build:frontend": "npm --prefix .. run build",
    "dev": "npm run build:frontend && wrangler dev",
    "dev:api": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=.wrangler-dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "samples:upload": "node scripts/upload-samples.mjs",
    "tail": "wrangler tail",
    "whoami": "wrangler whoami",
    "smoke": "node test/smoke-test.mjs",
    "mock": "node test/mock-gemini.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.20.0"
  }
}
